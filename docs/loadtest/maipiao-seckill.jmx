<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MaiPiao Rush Sale" enabled="true">
      <stringProp name="TestPlan.comments">Per-thread signed test identity joins the rush queue, polls admission, and assigns one seat.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Rush buyers" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Once per buyer" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads,100)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampSeconds,10)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Queue, wait, and allocate" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import java.nio.charset.StandardCharsets
import java.util.Base64
import java.net.HttpURLConnection
import java.net.URL

SampleResult.sampleStart()
def baseUrl = props.getProperty('baseUrl', 'http://127.0.0.1:9000').replaceAll('/+$', '')
def scheduleId = props.getProperty('scheduleId', '')
def tierId = props.getProperty('tierId', '')
def secret = props.getProperty('jwtSecret', 'maipiao-ticket-local-dev-secret-key-change-me-in-production-2026')
def timeoutMs = (props.getProperty('timeoutMs', '30000') as int)
def userId = (props.getProperty('userIdBase', '3000000000000000000') as long) + ctx.getThreadNum()
def encode = { byte[] bytes -> Base64.getUrlEncoder().withoutPadding().encodeToString(bytes) }
def now = System.currentTimeMillis() / 1000L
def header = encode(JsonOutput.toJson([alg: 'HS256', typ: 'JWT']).getBytes(StandardCharsets.UTF_8))
def claims = [sub: userId.toString(), jti: UUID.randomUUID().toString().replace('-', ''),
              phone: '13900000000', role: 'USER', iss: 'maipiao-ticket', iat: now, exp: now + 3600]
def payload = encode(JsonOutput.toJson(claims).getBytes(StandardCharsets.UTF_8))
def unsigned = header + '.' + payload
def mac = Mac.getInstance('HmacSHA256')
mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), 'HmacSHA256'))
def token = unsigned + '.' + encode(mac.doFinal(unsigned.getBytes(StandardCharsets.UTF_8)))

def request = { String method, String path, Object body ->
    HttpURLConnection connection = (HttpURLConnection) new URL(baseUrl + path).openConnection()
    connection.setRequestMethod(method)
    connection.setConnectTimeout(5000)
    connection.setReadTimeout(timeoutMs)
    connection.setRequestProperty('Authorization', 'Bearer ' + token)
    connection.setRequestProperty('Accept', 'application/json')
    if (body != null) {
        connection.setDoOutput(true)
        connection.setRequestProperty('Content-Type', 'application/json')
        connection.outputStream.withCloseable { it.write(JsonOutput.toJson(body).getBytes(StandardCharsets.UTF_8)) }
    }
    int status = connection.responseCode
    InputStream stream = status < 400 ? connection.inputStream : connection.errorStream
    String text = stream == null ? '' : stream.getText('UTF-8')
    connection.disconnect()
    [status: status, text: text]
}

try {
    if (!scheduleId || !tierId) {
        throw new IllegalArgumentException('Set -JscheduleId and -JtierId to a prepared rush-sale session and tier')
    }
    def joined = request('POST', '/api/queue/join?scheduleId=' + scheduleId, null)
    if (joined.status != 200) throw new IllegalStateException('queue join HTTP ' + joined.status + ': ' + joined.text)
    def joinBody = new JsonSlurper().parseText(joined.text)
    if (joinBody.data?.status == 'SOLD_OUT') {
        SampleResult.setSampleLabel('rush-sold-out')
        SampleResult.setResponseCode('200')
        SampleResult.setResponseMessage('Expected sold-out response')
        SampleResult.setResponseData(joined.text, 'UTF-8')
        SampleResult.setSuccessful(true)
    } else if (!joinBody.success) {
        throw new IllegalStateException('queue join rejected: ' + joined.text)
    } else {
        long deadline = System.currentTimeMillis() + timeoutMs
        String admission = joinBody.data?.token?.toString()
        String state = joinBody.data?.status?.toString()
        while (System.currentTimeMillis() < deadline
                && state != 'SOLD_OUT'
                && (state != 'PASSED' || !admission)) {
            Thread.sleep(200)
            def position = request('GET', '/api/queue/position?scheduleId=' + scheduleId, null)
            if (position.status != 200) throw new IllegalStateException('queue poll HTTP ' + position.status)
            def positionBody = new JsonSlurper().parseText(position.text)
            if (!positionBody.success) throw new IllegalStateException('queue poll rejected: ' + position.text)
            state = positionBody.data?.status?.toString()
            admission = positionBody.data?.token?.toString()
        }
        if (state == 'SOLD_OUT') {
            SampleResult.setSampleLabel('rush-sold-out')
            SampleResult.setResponseCode('200')
            SampleResult.setResponseMessage('Expected sold-out response')
            SampleResult.setSuccessful(true)
        } else if (state != 'PASSED' || !admission) {
            throw new IllegalStateException('queue admission timed out; last state=' + state)
        } else {
            def assigned = request('POST', '/api/seat/assign?scheduleId=' + scheduleId,
                    [scheduleId: scheduleId, tierId: tierId, quantity: 1, adjacent: true, queueToken: admission])
            def assignBody = new JsonSlurper().parseText(assigned.text)
            if (assigned.status == 200 && assignBody.success) {
                SampleResult.setSampleLabel('rush-seat-assigned')
                SampleResult.setResponseCode('200')
                SampleResult.setResponseMessage('Seat assigned')
                SampleResult.setSuccessful(true)
            } else if (assignBody.code == 10007 || assignBody.code == 10010 || assignBody.code == 50001) {
                SampleResult.setSampleLabel('rush-sold-out')
                SampleResult.setResponseCode('200')
                SampleResult.setResponseMessage('Expected sold-out response')
                SampleResult.setSuccessful(true)
            } else {
                throw new IllegalStateException('seat assignment HTTP ' + assigned.status + ': ' + assigned.text)
            }
        }
    }
} catch (Throwable error) {
    SampleResult.setSampleLabel('rush-error')
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage(error.toString())
    SampleResult.setResponseData(error.toString(), 'UTF-8')
    SampleResult.setSuccessful(false)
} finally {
    SampleResult.sampleEnd()
}
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="Results" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>true</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename">${__P(results,results/maipiao-seckill.jtl)}</stringProp>
      </ResultCollector>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>

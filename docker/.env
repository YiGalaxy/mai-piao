# ============================================================
# Host port mapping for the local dev stack.
#
# Every value is optional - docker-compose.yml carries the same number
# as a fallback. The file exists so that a port clash can be fixed here
# instead of by editing the compose file.
#
# These particular numbers were chosen because the machine this project
# was set up on already had other containers and a native service bound
# to the default ports. Adjust freely; nothing outside this file and the
# services' own application.yml needs to change.
# ============================================================

# Default 3306 taken by a native MySQL service (plus projects on 3307/3308/3310)
MYSQL_PORT=3309

# Default 6379 taken by xtdp-redis (6380 = yiguixingtu, 16379 = bulk-trade)
REDIS_PORT=6381

# Default 8848/9848 taken by zhy-nacos.
# NACOS_GRPC_PORT must stay NACOS_PORT + 1000 - that offset is how a
# Nacos 2.x client derives its gRPC port.
NACOS_PORT=8858
NACOS_GRPC_PORT=9858

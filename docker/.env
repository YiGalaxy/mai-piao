# ============================================================
# 本地开发这套环境的宿主端口映射。
#
# 每个值都是可选的——docker-compose.yml 里带着同样的数字作为兜底。
# 这个文件存在的意义是：端口冲突时在这里改就行，不必去动 compose 文件。
#
# 之所以挑这几个数字，是因为当初搭这个项目的机器上，默认端口已经
# 被别的容器和一个原生服务占了。随便改，除了这个文件和服务各自的
# application.yml，别的地方都不用动。
# ============================================================

# 默认的 3306 被本机原生 MySQL 服务占了（另外 3307/3308/3310 上还有别的项目）
MYSQL_PORT=3309

# 默认的 6379 被 xtdp-redis 占了（6380 = yiguixingtu，16379 = bulk-trade）
REDIS_PORT=6381

# 默认的 8848/9848 被 zhy-nacos 占了。
# NACOS_GRPC_PORT 必须保持 = NACOS_PORT + 1000，Nacos 2.x 客户端
# 就是靠这个偏移量推出 gRPC 端口的。
NACOS_PORT=8858
NACOS_GRPC_PORT=9858

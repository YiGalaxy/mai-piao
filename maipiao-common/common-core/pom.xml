<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.maipiao</groupId>
    <artifactId>maipiao-ticket</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>common-core</artifactId>
  <name>common-core</name>
  <description>统一返回体、业务异常、错误码、ID 生成</description>

  <dependencies>
    <!-- 统一响应体上的 @JsonInclude / @JsonFormat 需要 Jackson -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- JWT 放在这里而不是 common-web，是为了让网关也能用。
         网关是 WebFlux 应用，不能把 spring-boot-starter-web 拖进来，
         而 common-web 依赖它；把 token 解析留在没有 web 栈的模块里，
         就只有一份实现，而不是两份慢慢跑偏的实现。 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- 给 JwtProperties 上的 @ConfigurationProperties 用。
         刻意用光秃秃的 spring-boot 而不是 starter：starter 会把 autoconfigure
         和 logging 拖进每一个模块，而这个只带来 spring-core/context ——
         任何用这个模块的地方本来就有。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
  </dependencies>
</project>

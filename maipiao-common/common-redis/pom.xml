<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.maipiao</groupId>
    <artifactId>maipiao-ticket</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>common-redis</artifactId>
  <name>common-redis</name>
  <description>Redis / Redisson 配置、Lua 脚本加载、bitmap 辅助</description>

  <dependencies>
    <dependency>
      <groupId>com.maipiao</groupId>
      <artifactId>common-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Lettuce 连接池 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>
    <!-- Redisson：那些光靠裸写一段 Lua 脚本表达不了的
         分布式锁和限流器。 -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>

    <!--
      ShedLock —— 只被 SchedulerLockConfig 用到，所以标成 optional：
      这个模块被所有连 Redis 的服务依赖，而其中只有 order 和 pay 需要给定时任务加锁。
      不标的话，每个服务都会平白多出一个定时任务锁框架。

      order 和 pay 仍要各自声明这两个依赖 —— optional 不传递，这正是它的定义。
    -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-redis-spring</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>

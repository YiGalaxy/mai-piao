# ============================================================
# Local overrides
#
# Note: docker/.env IS tracked on purpose. It holds the host port mapping
# (3309/6381/8858) which is part of how this project is meant to be run
# locally, and it contains no secrets - the dev passwords live in
# docker-compose.yml, which is also tracked because it is a dev-only stack.
# ============================================================
*.local.yml
application-local.yml
application-dev-local.yml
